// SPAG Buddy School: the classroom edition. Links SPAGCore and SPAGSchoolSync.

PRODUCT_NAME = SPAG Buddy School
PRODUCT_BUNDLE_IDENTIFIER = Digital-Clubhouse.SPAG-Buddy-School
INFOPLIST_KEY_CFBundleDisplayName = SPAG School

ASSETCATALOG_COMPILER_APPICON_NAME = SchoolAppIcon
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = AccentColor

INFOPLIST_FILE = SPAG Buddy School/Info.plist
CODE_SIGN_ENTITLEMENTS = SPAG Buddy School/SPAGBuddySchool.entitlements

// The teacher dashboard API, e.g. https://<project-ref>.supabase.co/functions/v1/api.
// Empty means joining a class and syncing are switched off. xcconfig treats // as a comment,
// so write the URL as https:/$()/<host>/functions/v1/api.
SPAG_API_BASE_URL =
