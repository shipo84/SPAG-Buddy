# Supabase project (use the EU/London region). The anon key is safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional. Defaults to $NEXT_PUBLIC_SUPABASE_URL/functions/v1/api
NEXT_PUBLIC_API_URL=

# Set to true to explore the dashboard with made-up pupils and no backend.
NEXT_PUBLIC_DEMO_MODE=false
